<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Button Style -->
    <style name="CustomButton">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <!-- Spinner Style -->
    <style name="CustomSpinner" parent="android:Widget.Spinner">
        <item name="android:background">@drawable/spinner_background</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="CustomSpinnerStyle">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Custom dropdown list style -->
    <style name="CustomSpinnerDropdown">
        <item name="android:background">#ffffff</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- EditText Style -->
    <style name="CustomEditText">
        <item name="android:background">@drawable/edittext_background</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:textColor">#333333</item>
    </style>

    <!-- TextView Style -->
    <style name="CustomTextView">
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <!-- CardView Style -->
    <style name="CustomCardView">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
    </style>



    <style name="Theme.MyApplication1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>




    <style name="TextAppearance"></style>

    <style name="CalcButtonStyle">
        <item name="android:textSize">30sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">#8F7D92</item>
        <item name="android:textColor">#0D0D0D</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>

    </style>



</resources>
